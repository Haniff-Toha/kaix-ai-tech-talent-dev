# ──────────────────────────────────────────────
# Kaix Backend — Environment Variables
# Copy to .env and fill in actual values
# ──────────────────────────────────────────────

# ─── App ───
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Database (Supabase PostgreSQL) ───
DATABASE_URL=DATABASE_URL

# ─── Supabase Auth ───
SUPABASE_URL=SUPABASE_URL
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ─── NVIDIA NIM (Reasoning LLM — primary) ───
NVIDIA_API_KEY=NVIDIA_API_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=minimaxai/minimax-m2.7

# ─── Groq (Reasoning fallback + Fast LLM + Vision) ───
GROQ_API_KEY=GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=google/gemma-3-27b-it
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ─── Google Gemini (Embeddings) ───
GEMINI_API_KEY=GEMINI_API_KEY
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# ─── Embedding Config ───
EMBEDDING_DIMENSION=768

# ─── CORS ───
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── YouTube Data API ───
YOUTUBE_API_KEY=YOUTUBE_API_KEY

# ─── Email — Brevo (primary SMTP) ───
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_API_KEY=
EMAIL_FROM=